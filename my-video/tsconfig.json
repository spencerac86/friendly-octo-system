{
  "compilerOptions": {
    "lib": ["dom"],
    "jsx": "react",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*", "remotion.config.ts"]
}
